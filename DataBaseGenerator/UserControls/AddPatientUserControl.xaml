<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.AddPatientUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DataBaseGenerator.UI.Wpf.UserControls"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:DataBaseGenerator.UI.Wpf.ViewModel">

    <Grid Name="AddPatients">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="5">

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top">

                    <!--  Patient ID  -->
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="DemiBold" Text="Patient ID *" />
                        <TextBlock
                            Grid.Column="1"
                            MinWidth="20"
                            Margin="5,0"
                            Foreground="Black"
                            Text="{Binding Text.Length, ElementName=PatientIdTextBox, StringFormat={}{0}}"
                            TextAlignment="Right" />
                    </Grid>

                    <TextBox
                        x:Name="PatientIdTextBox"
                        Margin="5,0"
                        Text="{Binding AddIdPatient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Surname  -->
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="DemiBold" Text="Surname: *" />
                        <TextBlock
                            Grid.Column="1"
                            MinWidth="20"
                            Margin="5,0"
                            Foreground="Black"
                            Text="{Binding Text.Length, ElementName=FamilyTextBox, StringFormat={}{0}}"
                            TextAlignment="Right" />
                    </Grid>

                    <TextBox
                        x:Name="FamilyTextBox"
                        Margin="5,0"
                        Text="{Binding AddFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Name  -->
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="DemiBold" Text="Name: *" />
                        <TextBlock
                            Grid.Column="1"
                            MinWidth="20"
                            Margin="5,0"
                            Foreground="Black"
                            Text="{Binding Text.Length, ElementName=NameTextBox, StringFormat={}{0}}"
                            TextAlignment="Right" />
                    </Grid>

                    <TextBox
                        x:Name="NameTextBox"
                        Margin="5,0"
                        Text="{Binding AddName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Middle name  -->
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="DemiBold" Text="Middle name: *" />
                        <TextBlock
                            Grid.Column="1"
                            MinWidth="20"
                            Margin="5,0"
                            Foreground="Black"
                            Text="{Binding Text.Length, ElementName=MiddleNameTextBox, StringFormat={}{0}}"
                            TextAlignment="Right" />
                    </Grid>

                    <TextBox
                        x:Name="MiddleNameTextBox"
                        Margin="5,0"
                        Text="{Binding AddMiddleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Birthdate  -->
                    <TextBlock
                        Margin="5,5,0,0"
                        FontWeight="DemiBold"
                        Text="Birthdate:" />

                    <mah:DateTimePicker
                        Margin="5"
                        Culture="ru"
                        SelectedDateFormat="Short"
                        SelectedDateTime="{Binding PatientBirthDate, Mode=TwoWay}"
                        SelectedTimeFormat="Long" />

                    <!--  Gender  -->
                    <TextBlock
                        Margin="5,5,0,0"
                        FontWeight="DemiBold"
                        Text="Gender:" />

                    <ComboBox
                        Margin="5"
                        ItemsSource="{Binding Gender}"
                        SelectedItem="{Binding SelecedGender}" />

                    <!--  Address  -->
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="DemiBold" Text="Address:" />
                        <TextBlock
                            Grid.Column="1"
                            MinWidth="20"
                            Margin="5,0"
                            Foreground="Black"
                            Text="{Binding Text.Length, ElementName=AddressTextBox, StringFormat={}{0}}"
                            TextAlignment="Right" />
                    </Grid>

                    <TextBox
                        x:Name="AddressTextBox"
                        Margin="5,0"
                        Text="{Binding AddAdress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Telephone  -->
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="DemiBold" Text="Telephone:" />
                        <TextBlock
                            Grid.Column="1"
                            MinWidth="20"
                            Margin="5,0"
                            Foreground="Black"
                            Text="{Binding Text.Length, ElementName=TelephoneTextBox, StringFormat={}{0}}"
                            TextAlignment="Right" />
                    </Grid>

                    <TextBox
                        x:Name="TelephoneTextBox"
                        Margin="5,0"
                        Text="{Binding AddTelephone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Place of work  -->
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="DemiBold" Text="Place of work" />
                        <TextBlock
                            Grid.Column="1"
                            MinWidth="20"
                            Margin="5,0"
                            Foreground="Black"
                            Text="{Binding Text.Length, ElementName=WorkPlaceTextBox, StringFormat={}{0}}"
                            TextAlignment="Right" />
                    </Grid>

                    <TextBox
                        x:Name="WorkPlaceTextBox"
                        Margin="5,0"
                        Text="{Binding AddWorkPlase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Additional information  -->
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="DemiBold" Text="Additional information:" />
                        <TextBlock
                            Grid.Column="1"
                            MinWidth="20"
                            Margin="5,0"
                            Foreground="Black"
                            Text="{Binding Text.Length, ElementName=InfoTextBox, StringFormat={}{0}}"
                            TextAlignment="Right" />
                    </Grid>

                </StackPanel>

                <!--  Additional information text  -->
                <TextBox
                    x:Name="InfoTextBox"
                    MinHeight="80"
                    Margin="5"
                    VerticalContentAlignment="Top"
                    AcceptsReturn="True"
                    Text="{Binding AddInfo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />

            </DockPanel>
        </Border>

        <UniformGrid
            Grid.Row="1"
            Margin="0,10,0,0"
            Columns="2">

            <Button
                Height="50"
                Margin="5,0"
                Command="{Binding AddOnePatientCommand}"
                Content="Add" />

            <Button
                Height="50"
                Margin="5,0"
                Command="{Binding CancelAddPatientCommand}"
                Content="Cancel" />

        </UniformGrid>
    </Grid>
</UserControl>