<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.StudiesLiteDbTableUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:DataBaseGenerator.UI.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DataBaseGenerator.UI.Wpf.UserControls"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="clr-namespace:DataBaseGenerator.UI.Wpf.UserControls"
    xmlns:viewmodel="clr-namespace:DataBaseGenerator.UI.Wpf.ViewModel">



    <UserControl.Resources>
        <convert:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter" />
        <convert:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>


    <Grid Margin="5,0" ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <userControls:SelectionFileUserControl Height="72" Margin="0,5" />

        <Grid
            Name="StudiesTable"
            Grid.Row="1"
            Height="420"
            Background="{DynamicResource MahApps.Brushes.Accent}">
            <DataGrid
                Name="ViewAllStudies"
                Margin="5"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                IsReadOnly="False"
                ItemsSource="{Binding AllStudies}"
                ScrollViewer.IsDeferredScrollingEnabled="True"
                SelectedItem="{Binding SelectedStudy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">

                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding StudyInstanceUid}" Header="UID исследования" />
                    <DataGridTextColumn Binding="{Binding StudyId}" Header="ID исследования" />
                    <DataGridTextColumn Binding="{Binding PatientId}" Header="PatientId (DB)" />
                    <DataGridTextColumn Binding="{Binding SnapshotLastName}" Header="Фамилия" />
                    <DataGridTextColumn Binding="{Binding SnapshotFirstName}" Header="Имя" />
                    <DataGridTextColumn Binding="{Binding SnapshotPatronymic}" Header="Отчество" />
                    <DataGridTextColumn Binding="{Binding SnapshotPatientId}" Header="Patient ID" />
                    <DataGridTextColumn Binding="{Binding PatientBirthDate, StringFormat='dd.MM.yyyy'}" Header="Дата рождения" />
                    <DataGridTextColumn Binding="{Binding AccessionNumber}" Header="Accession №" />
                    <DataGridTextColumn Binding="{Binding BodyPartsDisplay}" Header="Области исследования" />
                    <DataGridTextColumn Binding="{Binding StudyDateTime, StringFormat='dd.MM.yyyy HH:mm'}" Header="Дата исследования" />
                    <DataGridTextColumn Binding="{Binding EffectiveDosemSv}" Header="Эфф. доза (мЗв)" />
                    <DataGridTextColumn Binding="{Binding Status}" Header="Статус" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid
            Grid.Row="2"
            Grid.RowSpan="2"
            Grid.Column="1"
            Grid.ColumnSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Name="BlockCheckBoxes">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="5">
                    <StackPanel Orientation="Vertical">
                        <CheckBox
                            Margin="5"
                            Content="Eng Names"
                            FontSize="12"
                            FontWeight="Bold"
                            IsChecked="{Binding UseEngNames}" />
                        <CheckBox
                            Margin="5"
                            Content="Rus Names"
                            FontSize="12"
                            FontWeight="Bold"
                            IsChecked="{Binding UseRusNames}" />
                        <CheckBox
                            Margin="5"
                            Content="China Names"
                            FontSize="12"
                            FontWeight="Bold"
                            IsChecked="{Binding UseChinaNames}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1" Margin="5">
                    <StackPanel Orientation="Vertical">
                        <CheckBox
                            Margin="5"
                            Content="Empty strings"
                            FontSize="12"
                            FontWeight="Bold"
                            IsChecked="{Binding UseEmptyStrings}" />
                        <CheckBox
                            Margin="5"
                            Content="Long values"
                            FontSize="12"
                            FontWeight="Bold"
                            IsChecked="{Binding UseLongValues}" />
                        <CheckBox
                            Margin="5"
                            Content="Special characters"
                            FontSize="12"
                            FontWeight="Bold"
                            IsChecked="{Binding UseSpecialChars}" />
                    </StackPanel>
                </Grid>

                <Grid
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Margin="5">
                    <StackPanel Orientation="Vertical">
                        <RadioButton
                            Margin="5"
                            Content="Random birthdate"
                            FontSize="12"
                            FontWeight="Bold"
                            GroupName="BirthdateSection"
                            IsChecked="{Binding UseRandomBirthdate}" />
                        <RadioButton
                            Margin="5"
                            Content="Missing birthdate"
                            FontSize="12"
                            FontWeight="Bold"
                            GroupName="BirthdateSection"
                            IsChecked="{Binding UseMissingBirthdate}" />
                        <RadioButton
                            Margin="5"
                            Content="Future birthdate"
                            FontSize="12"
                            FontWeight="Bold"
                            GroupName="BirthdateSection"
                            IsChecked="{Binding UseFutureBirthdate}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="3" Margin="5">
                    <StackPanel Orientation="Vertical">
                        <RadioButton
                            Margin="5"
                            Content="0 - 17 years"
                            FontSize="12"
                            FontWeight="Bold"
                            GroupName="BirthdateSection"
                            IsChecked="{Binding UseAge0_17}" />
                        <RadioButton
                            Margin="5"
                            Content="18 - 60 years"
                            FontSize="12"
                            FontWeight="Bold"
                            GroupName="BirthdateSection"
                            IsChecked="{Binding UseAge18_60}" />
                        <RadioButton
                            Margin="5"
                            Content="61 - 120 years"
                            FontSize="12"
                            FontWeight="Bold"
                            GroupName="BirthdateSection"
                            IsChecked="{Binding UseAge61_120}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid
                Name="ButtonsBlock"
                Grid.Row="1"
                IsEnabled="{Binding IsReadOnlyMode, Mode=TwoWay, Converter={StaticResource BoolToInverseBoolConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Name="TextBoxStudiesCount"
                    Grid.ColumnSpan="2"
                    Margin="5"
                    Orientation="Horizontal">

                    <TextBlock
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Text="Studies Count" />

                    <TextBox
                        Name="StudiesCount"
                        Width="100"
                        Height="50"
                        Margin="20,0"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource MahApps.Brushes.Button.Border}"
                        BorderBrush="Black"
                        FontWeight="Bold"
                        Text="{Binding SetStudiesCount, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Text="Series Count" />

                    <TextBox
                        Name="SeriesCount"
                        Width="100"
                        Height="50"
                        Margin="20,0"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource MahApps.Brushes.Button.Border}"
                        BorderBrush="Black"
                        FontWeight="Bold"
                        Text="{Binding SetSeriesCount, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Text="Image Count" />

                    <TextBox
                        Name="ImageCount"
                        Width="100"
                        Height="50"
                        Margin="20,0"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource MahApps.Brushes.Button.Border}"
                        BorderBrush="Black"
                        FontWeight="Bold"
                        Text="{Binding SetImageCount, UpdateSourceTrigger=PropertyChanged}" />

                </StackPanel>

                <!--<Grid
                    Name="ButtonAddStudies"
                    Grid.Column="1"
                    Margin="5">

                    <Button
                        Name="AddStudies"
                        Width="80"
                        Height="50"
                        HorizontalAlignment="Right"
                        Command="{Binding AddStudiesCommand}">
                        <TextBlock
                            Margin="5,0"
                            FontSize="10"
                            Text="ADD STUDIES"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>

                    <Button
                        Name="SavePatient"
                        Width="80"
                        Height="50"
                        HorizontalAlignment="Center">
                        <TextBlock
                            Margin="5,0"
                            FontSize="10"
                            Text="SAVE STUDIES"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>

                    <Button
                        Name="UpdatePatient"
                        Width="80"
                        Height="50"
                        HorizontalAlignment="Right"
                        Command="{Binding RefreshDataBaseCommand}">
                        <TextBlock
                            FontSize="10"
                            Text="UPDATE STUDIES"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>
                </Grid>-->

                <StackPanel
                    Name="ButtonDeleteFirstPatient"
                    Grid.Column="2"
                    Margin="5"
                    Orientation="Horizontal">

                    <Button
                        Name="AddStudies"
                        Width="80"
                        Height="50"
                        Margin="5,0"
                        Command="{Binding AddStudiesCommand}">
                        <TextBlock
                            Margin="5,0"
                            FontSize="10"
                            Text="ADD STUDIES"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>

                    <Button
                        Name="DeleteFirstPatient"
                        Width="80"
                        Height="50"
                        Margin="5,0">
                        <TextBlock
                            FontSize="10"
                            Text="CLEAN CHECKBOX"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>

                    <Button
                        Name="CleanCheckbox"
                        Width="80"
                        Height="50"
                        Margin="5,0">
                        <TextBlock
                            Margin="5,0"
                            FontSize="10"
                            Text="DELETE FIRST"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>

                    <Button
                        Name="DeleteAllPatient"
                        Width="80"
                        Height="50"
                        Margin="5,0"
                        Command="{Binding DeleteAllCommand}">
                        <TextBlock
                            Margin="10,0"
                            FontSize="10"
                            Text="DELETE ALL"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <userControls:FooterUserControl
            Grid.Row="4"
            Height="117"
            Margin="0,5" />

        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" Opacity=".7">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <mah:ProgressRing
                        Width="100"
                        Height="100"
                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                        IsActive="{Binding IsBusy}" />

                    <TextBlock
                        Margin="0,-60,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                        Text="{Binding CurrentProgress, StringFormat='{}{0}%'}"
                        Visibility="{Binding PercentShow, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock
                        Margin="0,30,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="Black"
                        Text="{Binding BusyMessage}" />
                </StackPanel>
            </Border>
            <Button
                Width="120"
                Height="50"
                Margin="350,0,0,3"
                VerticalAlignment="Bottom"
                Command="{Binding CancelGenerationCommand}"
                Content="Cancel" />
        </Grid>

    </Grid>
</UserControl>
