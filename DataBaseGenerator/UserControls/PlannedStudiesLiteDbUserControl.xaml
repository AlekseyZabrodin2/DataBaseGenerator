<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.PlannedStudiesLiteDbUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:DataBaseGenerator.UI.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DataBaseGenerator.UI.Wpf.UserControls"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="clr-namespace:DataBaseGenerator.UI.Wpf.UserControls"
    Height="783">




    <UserControl.Resources>
        <convert:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter" />
        <convert:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>


    <Grid Margin="5,0" ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <userControls:SelectionFileUserControl Height="72" Margin="0,5" />

        <Grid Grid.Row="1" ShowGridLines="False">

            <Border
                Grid.Row="0"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                Margin="0,0,0,5"
                Padding="5"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                BorderThickness="5">

                <Grid ShowGridLines="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Height="35"
                        Padding="6,0"
                        Background="#F5F5F5"
                        BorderBrush="#CCC"
                        BorderThickness="1">
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding DatabasePatientPathShort}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding DatabasePatientPath}" />
                    </Border>

                    <!--  Кнопка выбора файла  -->
                    <Button
                        Grid.Column="1"
                        Width="35"
                        Height="35"
                        Margin="5,0"
                        Padding="1,0,1,4"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource MahApps.Brushes.Accent}"
                        Command="{Binding BrowsePatientDatabaseCommand}"
                        Content="📁"
                        FontSize="20"
                        ToolTip="Выбрать файл базы данных" />

                </Grid>
            </Border>
        </Grid>

        <Grid
            Name="PlannedStudiesTable"
            Grid.Row="2"
            VerticalAlignment="Stretch"
            Background="{DynamicResource MahApps.Brushes.Accent}">
            <DataGrid
                Name="ViewAllPlannedStudies"
                Margin="5"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                IsReadOnly="True"
                ItemsSource="{Binding PlannedStudies}"
                ScrollViewer.IsDeferredScrollingEnabled="True"
                SelectedItem="{Binding SelectedPlannedStudy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">

                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding PatientIdDataBase}" Header="PatientId (DB)" />
                    <DataGridTextColumn Binding="{Binding PatientId}" Header="Patient ID" />
                    <DataGridTextColumn Binding="{Binding PatientLastName}" Header="Фамилия" />
                    <DataGridTextColumn Binding="{Binding PatientFirstName}" Header="Имя" />
                    <DataGridTextColumn Binding="{Binding PatientMiddleName}" Header="Отчество" />
                    <DataGridTextColumn Binding="{Binding BirthDate, StringFormat='dd.MM.yyyy'}" Header="Дата рождения" />
                    <DataGridTextColumn Binding="{Binding Gender}" Header="Пол" />
                    <DataGridTextColumn Binding="{Binding Telephone}" Header="Телефон" />
                    <DataGridTextColumn Binding="{Binding Address}" Header="Адрес" />
                    <DataGridTextColumn Binding="{Binding Age}" Header="Возраст" />
                    <DataGridTextColumn Binding="{Binding Comments}" Header="Комментарии" />
                    <DataGridTextColumn Binding="{Binding StudyID}" Header="ID исследования" />
                    <DataGridTextColumn Binding="{Binding AccessionNumber}" Header="Accession №" />
                    <DataGridTextColumn Binding="{Binding StudyInstanceUid}" Header="UID исследования" />
                    <DataGridTextColumn Binding="{Binding StudyAreasDisplay}" Header="Области">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding StudyAreasTooltip}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding ProjectionPathsDisplay}" Header="Проекции">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding ProjectionPathsTooltip}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Status}" Header="Статус" />
                    <DataGridTextColumn Binding="{Binding ImagesCount}" Header="Кол-во снимков" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid
            Grid.Row="3"
            Grid.Column="1"
            Grid.ColumnSpan="3"
            Margin="0,5,0,0">

            <Grid Name="ButtonsBlock" IsEnabled="{Binding IsReadOnlyMode, Mode=TwoWay, Converter={StaticResource BoolToInverseBoolConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Name="TextBoxStudiesCount"
                    Grid.ColumnSpan="3"
                    Margin="5"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">

                    <TextBlock
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Text="Studies Count" />

                    <TextBox
                        Name="StudiesCount"
                        Width="100"
                        Height="50"
                        Margin="20,0"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource MahApps.Brushes.Button.Border}"
                        BorderBrush="Black"
                        FontWeight="Bold"
                        Text="{Binding SetStudiesCount, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Name="AddStudies"
                        Width="80"
                        Height="50"
                        Margin="5,0"
                        Command="{Binding AddStudiesCommand}">
                        <TextBlock
                            Margin="5,0"
                            FontSize="10"
                            Text="ADD STUDIES"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>

                    <Button
                        Name="DeleteFirstPatient"
                        Width="80"
                        Height="50"
                        Margin="5,0">
                        <TextBlock
                            FontSize="10"
                            Text="CLEAN CHECKBOX"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>

                    <Button
                        Name="CleanCheckbox"
                        Width="80"
                        Height="50"
                        Margin="5,0">
                        <TextBlock
                            Margin="5,0"
                            FontSize="10"
                            Text="DELETE FIRST"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>

                    <Button
                        Name="DeleteAllPatient"
                        Width="80"
                        Height="50"
                        Margin="5,0"
                        Command="{Binding DeleteAllCommand}">
                        <TextBlock
                            Margin="10,0"
                            FontSize="10"
                            Text="DELETE ALL"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <userControls:FooterUserControl
            Grid.Row="4"
            Height="117"
            Margin="0,5"
            VerticalAlignment="Bottom" />

        <Grid
            Grid.Row="0"
            Grid.RowSpan="5"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" Opacity=".7">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <mah:ProgressRing
                        Width="100"
                        Height="100"
                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                        IsActive="{Binding IsBusy}" />

                    <TextBlock
                        Margin="0,-60,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                        Text="{Binding CurrentProgress, StringFormat='{}{0}%'}"
                        Visibility="{Binding PercentShow, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock
                        Margin="0,30,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="Black"
                        Text="{Binding BusyMessage}" />
                </StackPanel>
            </Border>
            <Button
                Width="120"
                Height="50"
                Margin="380,0,0,5"
                VerticalAlignment="Bottom"
                Command="{Binding CancelGenerationCommand}"
                Content="Cancel"
                Visibility="{Binding CancelButtonIsVisibil, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

    </Grid>
</UserControl>
