<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.PatientGenerationOptionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:DataBaseGenerator.UI.Wpf.Converters">

    <UserControl.Resources>
        <convert:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5">
            <CheckBox
                Margin="5"
                Content="Eng Names"
                FontSize="12"
                FontWeight="Bold"
                IsChecked="{Binding UseEngNames}" />
            <CheckBox
                Margin="5"
                Content="Rus Names"
                FontSize="12"
                FontWeight="Bold"
                IsChecked="{Binding UseRusNames}" />
            <CheckBox
                Margin="5"
                Content="China Names"
                FontSize="12"
                FontWeight="Bold"
                IsChecked="{Binding UseChinaNames}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="5">
            <CheckBox
                Margin="5"
                Content="Empty strings"
                FontSize="12"
                FontWeight="Bold"
                IsChecked="{Binding UseEmptyStrings}" />
            <CheckBox
                Margin="5"
                Content="Long values"
                FontSize="12"
                FontWeight="Bold"
                IsChecked="{Binding UseLongValues}" />
            <CheckBox
                Margin="5"
                Content="Special characters"
                FontSize="12"
                FontWeight="Bold"
                IsChecked="{Binding UseSpecialChars}" />
        </StackPanel>

        <StackPanel
            Grid.Column="2"
            Grid.ColumnSpan="2"
            Margin="5">
            <RadioButton
                Margin="5"
                Content="Random birthdate"
                FontSize="12"
                FontWeight="Bold"
                GroupName="{Binding BirthdateGroupName}"
                IsChecked="{Binding BirthdateMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Random}" />
            <RadioButton
                Margin="5"
                Content="Missing birthdate"
                FontSize="12"
                FontWeight="Bold"
                GroupName="{Binding BirthdateGroupName}"
                IsChecked="{Binding BirthdateMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Missing}" />
            <RadioButton
                Margin="5"
                Content="Future birthdate"
                FontSize="12"
                FontWeight="Bold"
                GroupName="{Binding BirthdateGroupName}"
                IsChecked="{Binding BirthdateMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Future}" />
        </StackPanel>

        <StackPanel Grid.Column="3" Margin="5">
            <RadioButton
                Margin="5"
                Content="0 - 17 years"
                FontSize="12"
                FontWeight="Bold"
                GroupName="{Binding BirthdateGroupName}"
                IsChecked="{Binding BirthdateMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Age0To17}" />
            <RadioButton
                Margin="5"
                Content="18 - 60 years"
                FontSize="12"
                FontWeight="Bold"
                GroupName="{Binding BirthdateGroupName}"
                IsChecked="{Binding BirthdateMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Age18To60}" />
            <RadioButton
                Margin="5"
                Content="61 - 120 years"
                FontSize="12"
                FontWeight="Bold"
                GroupName="{Binding BirthdateGroupName}"
                IsChecked="{Binding BirthdateMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Age61To120}" />
        </StackPanel>
    </Grid>
</UserControl>
