<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.SelectionFileUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DataBaseGenerator.UI.Wpf.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">


    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid ShowGridLines="False">

        <Border
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="3"
            Margin="0"
            Padding="5"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="5">

            <Grid ShowGridLines="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Height="35"
                    Padding="6,0"
                    Background="#F5F5F5"
                    BorderBrush="#CCC"
                    BorderThickness="1">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding DatabasePathShort}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding DatabasePath}" />
                </Border>

                <!--  Кнопка выбора файла  -->
                <Button
                    Grid.Column="1"
                    Width="35"
                    Height="35"
                    Margin="5,0"
                    Padding="1,0,1,4"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource MahApps.Brushes.Accent}"
                    Command="{Binding BrowseDatabaseCommand}"
                    Content="📁"
                    FontSize="20"
                    ToolTip="Выбрать файл базы данных" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Режим:" />

                    <!--  Контейнер для переключателей  -->
                    <ToggleButton
                        Margin="0,0,5,0"
                        Command="{Binding ChangeDatadaseModeCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                        IsChecked="{Binding IsReadOnlyMode, Mode=TwoWay}"
                        Style="{StaticResource ToggleButtonStyle}" />
                </StackPanel>

                <!--  Кнопка обновления  -->
                <Button
                    Grid.Column="3"
                    Height="35"
                    Margin="5"
                    Command="{Binding RefreshDataBaseCommand}"
                    Content="Update data">
                    <Button.ToolTip>
                        <TextBlock Text="Загрузить актуальные данные из базы (F5)" />
                    </Button.ToolTip>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
