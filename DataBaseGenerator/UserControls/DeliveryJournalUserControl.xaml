<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.DeliveryJournalUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:DataBaseGenerator.UI.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="clr-namespace:DataBaseGenerator.UI.Wpf.UserControls"
    xmlns:viewmodel="clr-namespace:DataBaseGenerator.UI.Wpf.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:DeliveryJournalViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter" />
            <convert:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5,0" ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <userControls:SelectionFileUserControl Grid.Row="0" Margin="0,5" />

        <Grid Grid.Row="1" Background="{DynamicResource MahApps.Brushes.Accent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="5,5,5,0" Orientation="Horizontal">
                <TextBlock
                    Margin="10,0,8,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="Filter by status" />
                <ComboBox
                    Width="140"
                    VerticalContentAlignment="Center"
                    ItemsSource="{Binding StatusFilters}"
                    SelectedItem="{Binding SelectedStatusFilter}"
                    ToolTip="Только отображение (без перезагрузки из БД). Не влияет на импорт и смену статуса." />
                <TextBlock
                    Margin="20,0,8,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="ID patient" />
                <TextBox
                    Width="120"
                    VerticalContentAlignment="Center"
                    BorderBrush="Black"
                    Text="{Binding PatientIdFilter, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <DataGrid
                Grid.Row="1"
                Margin="5"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                IsReadOnly="True"
                ItemsSource="{Binding Rows}"
                ScrollViewer.IsDeferredScrollingEnabled="True"
                SelectedItem="{Binding SelectedRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="45"
                        Binding="{Binding RowNumber}"
                        Header="№" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding PatientId}"
                        Header="Patient ID" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding StudyInstanceUid}"
                        Header="Study UID" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding Status}"
                        Header="Status" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding FailureKind}"
                        Header="Failure" />
                    <DataGridTextColumn
                        Width="50"
                        Binding="{Binding FileCount}"
                        Header="Files" />
                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding EnqueuedAt, StringFormat='dd.MM.yy HH:mm'}"
                        Header="Enqueued" />
                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding LastAttemptAt, StringFormat='dd.MM.yy HH:mm'}"
                        Header="Last attempt" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border
            Grid.Row="2"
            Margin="0,5"
            Padding="4"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="4">
            <TextBox
                MinHeight="100"
                MaxHeight="170"
                IsReadOnly="True"
                Text="{Binding DetailText}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Border>

        <Grid Grid.Row="3" Margin="0,5,0,5">
            <StackPanel
                HorizontalAlignment="Center"
                IsEnabled="{Binding IsReadOnlyMode, Mode=TwoWay, Converter={StaticResource BoolToInverseBoolConverter}}"
                Orientation="Horizontal">
                <StackPanel Margin="0,0,70,0" Orientation="Horizontal">
                    <TextBlock
                        Margin="5"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Text="Import studies" />
                    <TextBox
                        Width="100"
                        Height="50"
                        Margin="10,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource MahApps.Brushes.Button.Border}"
                        BorderBrush="Black"
                        FontWeight="Bold"
                        Text="{Binding ImportFromStudiesCount, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Width="90"
                        Height="50"
                        Margin="15,0,0,0"
                        Command="{Binding ImportFromStudiesCommand}">
                        <TextBlock
                            Margin="5,0"
                            FontSize="10"
                            Text="ADD FROM STUDIES"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="12,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Text="Status" />
                    <ComboBox
                        Width="120"
                        Height="50"
                        Padding="10"
                        VerticalContentAlignment="Center"
                        FontWeight="DemiBold"
                        ItemsSource="{Binding ImportStatusOptions}"
                        SelectedItem="{Binding SelectedImportStatus}"
                        ToolTip="Статус при импорте и целевой статус для APPLY STATUS" />
                    <TextBox
                        Width="100"
                        Height="50"
                        Margin="10,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource MahApps.Brushes.Button.Border}"
                        BorderBrush="Black"
                        FontWeight="Bold"
                        Text="{Binding ApplyStatusCount, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Сколько записей сменить среди текущей выборки (Показать + ID пациента), в порядке таблицы" />
                    <Button
                        Width="90"
                        Height="50"
                        Margin="15,0,0,0"
                        Command="{Binding ApplySelectedStatusCommand}">
                        <TextBlock
                            Margin="5,0"
                            FontSize="10"
                            Text="APPLY STATUS"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>
                </StackPanel>

                <Button
                    Width="80"
                    Height="50"
                    Margin="40,0,0,0"
                    Command="{Binding ClearAllRecordsCommand}">
                    <TextBlock
                        Margin="5,0"
                        FontSize="10"
                        Text="DELETE ALL"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Button>
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="4"
            Margin="0,5,0,5"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="4">
            <TextBox
                Height="60"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                BorderThickness="0"
                FontSize="18"
                IsReadOnly="True"
                Text="{Binding UpdateText}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Border>

        <Grid
            Grid.RowSpan="5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" Opacity=".7">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <mah:ProgressRing
                        Width="100"
                        Height="100"
                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                        IsActive="{Binding IsBusy}" />

                    <TextBlock
                        Margin="0,-60,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                        Text="{Binding CurrentProgress, StringFormat='{}{0}%'}"
                        Visibility="{Binding PercentShow, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock
                        Margin="0,30,0,0"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        Foreground="Black"
                        Text="{Binding BusyMessage}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
