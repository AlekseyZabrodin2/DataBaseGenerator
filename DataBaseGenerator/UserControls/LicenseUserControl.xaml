<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.LicenseUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DataBaseGenerator.UI.Wpf.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:DataBaseGenerator.UI.Wpf.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:LicenseViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>

        <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#F7FAF8" />
            <GradientStop Offset="0.55" Color="#EAF4ED" />
            <GradientStop Offset="1" Color="#F4F8F5" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GreenButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#55A875" />
            <GradientStop Offset="1" Color="#287448" />
        </LinearGradientBrush>

        <Style x:Key="MainTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#193D2B" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

    </UserControl.Resources>

    <Border
        Grid.Row="0"
        Margin="5"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="4">

        <Grid Background="{StaticResource BackgroundBrush}">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="82" />
            </Grid.RowDefinitions>

            <!--  Декоративные волны внизу  -->
            <Grid Grid.Row="0" ClipToBounds="True">
                <Path
                    Height="190"
                    VerticalAlignment="Bottom"
                    Data="M 0,80 C 250,190 500,150 750,175 C 1050,205 1300,150 1600,40 L 1600,250 L 0,250 Z"
                    Fill="#388E5B"
                    Opacity="0.10"
                    Stretch="Fill" />

                <Path
                    Height="145"
                    VerticalAlignment="Bottom"
                    Data="M 0,65 C 300,155 550,120 800,135 C 1100,160 1350,110 1600,25 L 1600,200 L 0,200 Z"
                    Fill="#B7D9C1"
                    Opacity="0.12"
                    Stretch="Fill" />
            </Grid>

            <!--  Основная область  -->
            <Grid Grid.Row="0" Margin="35,25,35,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.9*" />
                </Grid.ColumnDefinitions>

                <!--  Левая иллюстрация  -->
                <Viewbox
                    Grid.Column="0"
                    Margin="0,15,15,20"
                    Stretch="Uniform">

                    <Grid Width="430" Height="500">

                        <!--  Декоративный фон  -->
                        <Ellipse
                            Width="370"
                            Height="370"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="#EAF4ED"
                            Opacity="0.8" />

                        <Ellipse
                            Width="330"
                            Height="330"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.8"
                            Stroke="#C9E3D1"
                            StrokeThickness="2" />

                        <!--  Документ  -->
                        <Border
                            Width="245"
                            Height="330"
                            Margin="0,15,35,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#FFFFFF"
                            BorderBrush="#91C5A2"
                            BorderThickness="4"
                            CornerRadius="22">

                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="24"
                                    Opacity="0.2"
                                    ShadowDepth="9" />
                            </Border.Effect>

                            <Grid Margin="30,35">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="65" />
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Значок документа  -->
                                <Border
                                    Width="65"
                                    Height="65"
                                    HorizontalAlignment="Left"
                                    Background="#EAF4ED"
                                    CornerRadius="14">

                                    <Path
                                        Width="34"
                                        Height="34"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 5,2 L 21,2 L 31,12 L 31,32 L 5,32 Z M 21,2 L 21,12 L 31,12"
                                        Stroke="#397A51"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="2.5" />
                                </Border>

                                <!--  Строки документа  -->
                                <Border
                                    Grid.Row="1"
                                    Width="145"
                                    Height="10"
                                    HorizontalAlignment="Left"
                                    Background="#397A51"
                                    CornerRadius="5" />

                                <Border
                                    Grid.Row="2"
                                    Width="170"
                                    Height="7"
                                    HorizontalAlignment="Left"
                                    Background="#C9E3D1"
                                    CornerRadius="4" />

                                <Border
                                    Grid.Row="3"
                                    Width="150"
                                    Height="7"
                                    HorizontalAlignment="Left"
                                    Background="#C9E3D1"
                                    CornerRadius="4" />

                                <Border
                                    Grid.Row="4"
                                    Width="125"
                                    Height="7"
                                    HorizontalAlignment="Left"
                                    Background="#C9E3D1"
                                    CornerRadius="4" />

                            </Grid>
                        </Border>

                        <!--  Зелёный щит с галочкой  -->
                        <Grid
                            Width="165"
                            Height="180"
                            Margin="0,0,0,25"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">

                            <Path
                                Data="M 82,5                       Q 115,25 155,30                       L 150,105                       Q 140,145 82,175                       Q 24,145 15,105                       L 10,30                       Q 50,25 82,5 Z"
                                Fill="#FFFFFF"
                                Stroke="#C9E3D1"
                                StrokeThickness="5" />

                            <Path
                                Width="130"
                                Height="153"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 82,5                       Q 115,25 155,30                       L 150,105                       Q 140,145 82,175                       Q 24,145 15,105                       L 10,30                       Q 50,25 82,5 Z"
                                Fill="#397A51"
                                Stretch="Fill" />

                            <Path
                                Width="65"
                                Height="45"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 5,23 L 22,40 L 58,5"
                                Stroke="#FFFFFF"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="9" />

                            <Grid.Effect>
                                <DropShadowEffect
                                    BlurRadius="16"
                                    Opacity="0.25"
                                    ShadowDepth="6" />
                            </Grid.Effect>
                        </Grid>

                        <!--  Декоративные элементы  -->
                        <Ellipse
                            Width="22"
                            Height="22"
                            Margin="25,80,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Fill="#91C5A2" />

                        <Ellipse
                            Width="14"
                            Height="14"
                            Margin="0,0,35,125"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Fill="#B7D9C1" />

                        <Ellipse
                            Width="12"
                            Height="12"
                            Margin="45,0,0,75"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Fill="#C9E3D1" />

                    </Grid>
                </Viewbox>

                <!--  Правая информационная область  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="15,0,25,0"
                    VerticalAlignment="Center">

                    <!--  Заголовок  -->
                    <TextBlock
                        FontSize="43"
                        FontWeight="Bold"
                        Style="{StaticResource MainTextStyle}"
                        Text="DataBase Generator" />

                    <TextBlock
                        Margin="0,0,0,32"
                        FontSize="27"
                        Foreground="#526F5A"
                        Text="Генератор базы данных DICOM" />

                    <!--  Предупреждение  -->
                    <Border
                        Margin="0,0,0,25"
                        Padding="25"
                        Background="#FCE0E3"
                        BorderBrush="#F5B7BF"
                        BorderThickness="1"
                        CornerRadius="16">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Viewbox
                                Width="80"
                                Height="80"
                                VerticalAlignment="Center">
                                <Grid Width="100" Height="100">
                                    <Path Data="M 50,5             Q 54,5 57,11             L 96,83             Q 102,96 88,96             L 12,96             Q -2,96 4,83             L 43,11             Q 46,5 50,5 Z" Fill="#E52329" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="65"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="!" />
                                </Grid>
                            </Viewbox>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                <TextBlock
                                    FontSize="25"
                                    FontWeight="Bold"
                                    Foreground="#C51D24"
                                    Text="{Binding LicenseStatus}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="20"
                                    Foreground="#193D2B"
                                    Text="Для дальнейшей работы с приложением необходимо активировать лицензию."
                                    TextWrapping="Wrap" />

                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Информация о сроках  -->
                    <Border
                        Margin="0,0,0,30"
                        Padding="25,20"
                        Background="#FFFFFF"
                        BorderBrush="#C9E3D1"
                        BorderThickness="1"
                        CornerRadius="16">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>

                            <!--  Дата окончания  -->
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="40"
                                    FontWeight="DemiBold"
                                    Foreground="#397A51"
                                    Text="&#xE787;" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock
                                        FontSize="16"
                                        Foreground="#526F5A"
                                        Text="Дата окончания пробного периода:"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Margin="0,5,0,0"
                                        FontSize="23"
                                        FontWeight="Bold"
                                        Foreground="#193D2B"
                                        Text="{Binding ExpiryDate}" />
                                </StackPanel>
                            </Grid>

                            <!--  Разделитель  -->
                            <Border
                                Grid.Column="1"
                                Margin="0,0,0,0"
                                Background="#C9E3D1" />

                            <!--  Прошедшие дни  -->
                            <Grid Grid.Column="2" Margin="25,0,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="40"
                                    FontWeight="DemiBold"
                                    Foreground="#397A51"
                                    Text="&#xE823;" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock
                                        FontSize="17"
                                        Foreground="#526F5A"
                                        Text="Прошло дней:" />

                                    <TextBlock
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="23"
                                        FontWeight="Bold"
                                        Foreground="#E52329"
                                        Text="{Binding DaysPassed}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  Активация  -->
                    <Button
                        Width="410"
                        Height="70"
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center"
                        Background="{StaticResource GreenButtonBrush}"
                        BorderBrush="#526F5A"
                        BorderThickness="1"
                        Content="🔑   Активировать лицензию"
                        Command="{Binding ActivateLicenseCommand}"
                        Cursor="Hand"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="White">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="15">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="12"
                                            Opacity="0.2"
                                            ShadowDepth="4" />
                                    </Border.Effect>

                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>

                    <TextBlock
                        Margin="15,0,15,0"
                        FontSize="17"
                        Foreground="#526F5A"
                        Text="Если у вас есть лицензионный ключ, введите его и получите доступ ко всем функциям приложения."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                </StackPanel>

            </Grid>

            <!--  Нижняя строка  -->
            <Border
                Grid.Row="1"
                Background="#55EDF5EF"
                BorderBrush="#C9E3D1"
                BorderThickness="0,1,0,0">

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <TextBlock
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="#388E5B"
                        Text="ⓘ" />

                    <TextBlock
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        FontSize="17"
                        Foreground="#287448"
                        Text="При возникновении вопросов обратитесь в службу поддержки"
                        TextDecorations="Underline" />

                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>