<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.OrthancWorklistUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:DataBaseGenerator.UI.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:DataBaseGenerator.UI.Wpf.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:OrthancWorklistViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <convert:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <convert:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter" />
    </UserControl.Resources>

    <Grid Margin="5,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Column="0"
            Margin="0,5,5,5"
            IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToInverseBoolConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="5">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="DemiBold" Text="Patient ID" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="20"
                                Margin="5,0"
                                Foreground="Black"
                                Text="{Binding Text.Length, ElementName=PatientIdTextBox, StringFormat={}{0}}"
                                TextAlignment="Right" />
                        </Grid>
                        <TextBox
                            x:Name="PatientIdTextBox"
                            Margin="5,0"
                            Text="{Binding SinglePatientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="DemiBold" Text="Surname: *" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="20"
                                Margin="5,0"
                                Foreground="Black"
                                Text="{Binding Text.Length, ElementName=FamilyTextBox, StringFormat={}{0}}"
                                TextAlignment="Right" />
                        </Grid>
                        <TextBox
                            x:Name="FamilyTextBox"
                            Margin="5,0"
                            Text="{Binding SingleLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="DemiBold" Text="Name: *" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="20"
                                Margin="5,0"
                                Foreground="Black"
                                Text="{Binding Text.Length, ElementName=NameTextBox, StringFormat={}{0}}"
                                TextAlignment="Right" />
                        </Grid>
                        <TextBox
                            x:Name="NameTextBox"
                            Margin="5,0"
                            Text="{Binding SingleFirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="DemiBold" Text="Middle name: *" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="20"
                                Margin="5,0"
                                Foreground="Black"
                                Text="{Binding Text.Length, ElementName=MiddleNameTextBox, StringFormat={}{0}}"
                                TextAlignment="Right" />
                        </Grid>
                        <TextBox
                            x:Name="MiddleNameTextBox"
                            Margin="5,0"
                            Text="{Binding SingleMiddleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="5,5,0,0"
                            FontWeight="DemiBold"
                            Text="Birthdate:" />
                        <mah:DateTimePicker
                            Margin="5"
                            Culture="ru"
                            SelectedDateFormat="Short"
                            SelectedDateTime="{Binding SingleBirthDate, Mode=TwoWay}"
                            SelectedTimeFormat="Long" />

                        <TextBlock
                            Margin="5,5,0,0"
                            FontWeight="DemiBold"
                            Text="Gender:" />
                        <ComboBox
                            Margin="5"
                            ItemsSource="{Binding Gender}"
                            SelectedItem="{Binding SingleSex}" />

                        <TextBlock
                            Margin="5,5,0,0"
                            FontWeight="DemiBold"
                            Text="Modality:" />
                        <ComboBox
                            Margin="5"
                            ItemsSource="{Binding ModalityRules}"
                            SelectedItem="{Binding SingleModality, Mode=TwoWay}" />

                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="DemiBold" Text="Address:" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="20"
                                Margin="5,0"
                                Foreground="Black"
                                Text="{Binding Text.Length, ElementName=AddressTextBox, StringFormat={}{0}}"
                                TextAlignment="Right" />
                        </Grid>
                        <TextBox
                            x:Name="AddressTextBox"
                            Margin="5,0"
                            Text="{Binding SingleAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="DemiBold" Text="Telephone:" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="20"
                                Margin="5,0"
                                Foreground="Black"
                                Text="{Binding Text.Length, ElementName=TelephoneTextBox, StringFormat={}{0}}"
                                TextAlignment="Right" />
                        </Grid>
                        <TextBox
                            x:Name="TelephoneTextBox"
                            Margin="5,0"
                            Text="{Binding SingleTelephone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="DemiBold" Text="Description:" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="20"
                                Margin="5,0"
                                Foreground="Black"
                                Text="{Binding Text.Length, ElementName=DescriptionTextBox, StringFormat={}{0}}"
                                TextAlignment="Right" />
                        </Grid>
                        <TextBox
                            x:Name="DescriptionTextBox"
                            Margin="5,0"
                            Text="{Binding SingleDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="DemiBold" Text="Additional information:" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="20"
                                Margin="5,0"
                                Foreground="Black"
                                Text="{Binding Text.Length, ElementName=InfoTextBox, StringFormat={}{0}}"
                                TextAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <TextBox
                        x:Name="InfoTextBox"
                        MinHeight="80"
                        Margin="5"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        Text="{Binding SingleComments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>

            <UniformGrid
                Grid.Row="1"
                Margin="0,10,0,0"
                Columns="2">
                <Button
                    Height="50"
                    Margin="5,0"
                    Command="{Binding AddSinglePatientCommand}"
                    Content="Add" />
                <Button
                    Height="50"
                    Margin="5,0"
                    Command="{Binding ResetSinglePatientCommand}"
                    Content="Reset" />
            </UniformGrid>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,5"
                Padding="8,6"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                BorderThickness="4"
                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToInverseBoolConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0,8,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Orthanc URL" />
                    <TextBox
                        Width="280"
                        Height="32"
                        VerticalContentAlignment="Center"
                        BorderBrush="Black"
                        Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="16,0,8,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="User" />
                    <TextBox
                        Width="120"
                        Height="32"
                        VerticalContentAlignment="Center"
                        BorderBrush="Black"
                        Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="16,0,8,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Password" />
                    <TextBox
                        Width="120"
                        Height="32"
                        VerticalContentAlignment="Center"
                        BorderBrush="Black"
                        Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Height="32"
                        Margin="16,0,4,0"
                        Padding="20,0"
                        Background="{DynamicResource MahApps.Brushes.Accent}"
                        Command="{Binding EchoCommand}"
                        Content="Echo"
                        ToolTip="Проверить подключение к Orthanc" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Background="{DynamicResource MahApps.Brushes.Accent}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="5,5,5,0" Orientation="Horizontal">
                    <TextBlock
                        Margin="10,0,8,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="ID пациента" />
                    <TextBox
                        Width="160"
                        VerticalContentAlignment="Center"
                        BorderBrush="Black"
                        Text="{Binding PatientIdFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <DataGrid
                    Grid.Row="1"
                    Margin="5"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    EnableColumnVirtualization="True"
                    EnableRowVirtualization="True"
                    HorizontalScrollBarVisibility="Visible"
                    VerticalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    ItemsSource="{Binding Rows}"
                    ScrollViewer.IsDeferredScrollingEnabled="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding PatientId}"
                            Header="ID пациента"
                            SortDirection="Ascending" />
                        <DataGridTextColumn
                            Width="220"
                            Binding="{Binding PatientName}"
                            Header="Имя" />
                        <DataGridTextColumn
                            Width="50"
                            Binding="{Binding PatientSex}"
                            Header="Пол" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding PatientBirthDate}"
                            Header="Дата рождения" />
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding AccessionNumber}"
                            Header="Accession" />                        
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding ReferringPhysicianName}"
                            Header="Направивший врач" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding Modality}"
                            Header="Модальность" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding StationAeTitle}"
                            Header="AE Title" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding ScheduledStart}"
                            Header="Дата процедуры" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding Description}"
                            Header="Описание шага" />  
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid
                Grid.Row="2"
                Margin="5,8,5,0"
                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToInverseBoolConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Text="WorkList Count" />
                    <TextBox
                        Width="100"
                        Height="40"
                        Margin="0,0,20,0"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        BorderBrush="Black"
                        FontWeight="Bold"
                        Text="{Binding WorkListCount, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Column="1">
                    <TextBlock
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Text="Modality" />
                    <ComboBox
                        Width="100"
                        Height="40"
                        Margin="0,0,20,0"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        BorderBrush="Black"
                        FontWeight="Bold"
                        ItemsSource="{Binding ModalityRules}"
                        SelectedItem="{Binding SelectModality, Mode=TwoWay}" />
                </Grid>

                <Grid Grid.Column="2">
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Text="AE Title" />
                    <TextBox
                        Width="150"
                        Height="40"
                        Margin="0,0,5,0"
                        Padding="10,0"
                        HorizontalAlignment="Right"
                        VerticalContentAlignment="Center"
                        mah:TextBoxHelper.Watermark="Enter title:"
                        BorderBrush="Black"
                        FontWeight="Bold"
                        Text="{Binding SetAeTitle, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Grid>

            <Grid
                Grid.Row="3"
                Margin="5,5,5,0"
                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToInverseBoolConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Button
                        Width="130"
                        Height="40"
                        HorizontalAlignment="Left"
                        Command="{Binding AddWorkListCommand}"
                        Content="Add WorkList" />
                    <Button
                        Width="130"
                        Height="40"
                        HorizontalAlignment="Right"
                        Command="{Binding RefreshWorkListCommand}"
                        Content="Update WorkList" />
                </Grid>

                <Grid Grid.Column="2">
                    <Button
                        Width="130"
                        Height="40"
                        HorizontalAlignment="Left"
                        Command="{Binding DeleteFirstWorkListCommand}"
                        Content="Delete First WL" />
                    <Button
                        Width="130"
                        Height="40"
                        HorizontalAlignment="Right"
                        Command="{Binding DeleteAllWorkListCommand}"
                        Content="Delete All WL" />
                </Grid>
            </Grid>

            <Border
                Grid.Row="4"
                Margin="0,5"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                BorderThickness="4">
                <TextBox
                    Height="60"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    BorderThickness="0"
                    FontSize="18"
                    IsReadOnly="True"
                    Text="{Binding UpdateText}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </Border>
        </Grid>

        <Grid
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" Opacity=".7">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <mah:ProgressRing
                        Width="100"
                        Height="100"
                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                        IsActive="{Binding IsBusy}" />
                    <TextBlock
                        Margin="0,-60,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                        Text="{Binding CurrentProgress, StringFormat='{}{0}%'}"
                        Visibility="{Binding PercentShow, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock
                        Margin="0,30,0,0"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        Foreground="Black"
                        Text="{Binding BusyMessage}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
