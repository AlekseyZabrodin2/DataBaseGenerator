                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <mah:ProgressRing
                            Width="100"
                            Height="100"
                            Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                            IsActive="{Binding IsBusy}" />

                        <TextBlock
                            Margin="0,-60,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                            Text="{Binding CurrentProgress, StringFormat='{}{0}%'}"
                            Visibility="{Binding PercentShow, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock
                            Margin="0,30,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="Black"
                            Text="{Binding BusyMessage}" />
                    </StackPanel>
                </Border>
                <Button
                    Height="50"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource MahApps.Brushes.AccentBase}"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsEnabled="True"
                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>-->

        </Grid>
    </Border>
</UserControl>
