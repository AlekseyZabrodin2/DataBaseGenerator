<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.DicomPacsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:DataBaseGenerator.UI.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:DataBaseGenerator.UI.Wpf.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:DicomPacsViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <convert:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>


    <Border
        Grid.Row="0"
        Margin="5"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="4">


        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Настройки PACS  -->
            <Border
                Grid.Row="0"
                Margin="5"
                Padding="10"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                BorderThickness="4">

                <Grid x:Name="ConnectingBlock">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Параметры подключения  -->
                    <StackPanel Grid.Column="0" Margin="4">
                        <TextBlock FontWeight="DemiBold" Text="Клиент — AE Title:" />
                        <TextBox
                            Margin="0,4,0,0"
                            mah:TextBoxHelper.Watermark="Calling AE"
                            Text="{Binding CallingAe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4">
                        <TextBlock FontWeight="DemiBold" Text="Сервер IP:" />
                        <TextBox
                            Margin="0,4,0,0"
                            mah:TextBoxHelper.Watermark="IP сервера"
                            Text="{Binding ServerIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="4">
                        <TextBlock FontWeight="DemiBold" Text="Сервер Port:" />
                        <TextBox
                            Margin="0,4,0,0"
                            mah:TextBoxHelper.Watermark="Порт"
                            Text="{Binding ServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="4">
                        <TextBlock FontWeight="DemiBold" Text="Сервер — AE Title:" />
                        <TextBox
                            Margin="0,4,0,0"
                            mah:TextBoxHelper.Watermark="Called AE"
                            Text="{Binding CalledAe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!--  Папка с файлами  -->
                    <Grid
                        Grid.Row="1"
                        Grid.ColumnSpan="4"
                        Margin="4,8,4,4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontWeight="DemiBold"
                            Text="Папка:" />

                        <TextBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            mah:TextBoxHelper.Watermark="Выберите папку с DICOM-файлами"
                            Text="{Binding FolderPathShort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{Binding FolderPathFull}" />

                        <Button
                            Grid.Column="2"
                            Width="35"
                            Height="30"
                            Margin="6,0,0,0"
                            Padding="1"
                            Background="{DynamicResource MahApps.Brushes.Accent}"
                            Command="{Binding BrowseDatabaseCommand}"
                            Content="📁"
                            ToolTip="Выбрать папку" />
                    </Grid>

                    <!--  Действия с подключением  -->
                    <StackPanel
                        Grid.Row="2"
                        Grid.ColumnSpan="4"
                        Margin="4,6,4,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">

                        <Button
                            Height="30"
                            MinWidth="100"
                            Margin="0,0,8,0"
                            Background="{DynamicResource MahApps.Brushes.Accent}"
                            Command="{Binding SavePacsConfigurationsCommand}"
                            Content="Сохранить" />

                        <Button
                            Height="30"
                            MinWidth="80"
                            Background="{DynamicResource MahApps.Brushes.Accent}"
                            Command="{Binding EchoCommand}"
                            Content="Echo"
                            ToolTip="Проверить подключение к PACS" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Предпросмотр: занимает всё оставшееся место  -->
            <Border
                Grid.Row="1"
                Margin="5,0"
                Padding="10"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                BorderThickness="4">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Заголовок и управление выбором  -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <WrapPanel Margin="0,5,0,0">
                            <TextBlock FontWeight="DemiBold" Text="Исследований: " />
                            <TextBlock
                                Margin="0,0,20,0"
                                FontWeight="DemiBold"
                                Text="{Binding PreviewStudyCount}" />

                            <TextBlock FontWeight="DemiBold" Text="Файлов всего: " />
                            <TextBlock
                                Margin="0,0,20,0"
                                FontWeight="DemiBold"
                                Text="{Binding PreviewFileCount}" />

                            <TextBlock FontWeight="DemiBold" Text="К отправке: " />
                            <TextBlock
                                Margin="0,0,20,0"
                                FontWeight="DemiBold"
                                Text="{Binding SelectedFileCount}" />

                            <CheckBox
                                VerticalAlignment="Center"
                                Content="Выбрать все"
                                FontWeight="DemiBold"
                                IsChecked="{Binding AreAllStudiesSelected, Mode=TwoWay}" />
                        </WrapPanel>

                        <Button
                            Grid.Column="1"
                            Width="130"
                            Height="34"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource MahApps.Brushes.Accent}"
                            Command="{Binding PreviewStudiesCommand}"
                            Content="Предпросмотр" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Margin="-10"
                        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                        BorderThickness="0,4,0,0">
                        <DataGrid
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserSortColumns="False"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            GridLinesVisibility="All"
                            HeadersVisibility="Column"
                            HorizontalGridLinesBrush="#FF8A8A8A"
                            IsReadOnly="False"
                            ItemsSource="{Binding PreviewStudies}"
                            SelectionMode="Extended">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="65" Header="Выбор">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="2*"
                                    Binding="{Binding PatientName}"
                                    Header="Пациент"
                                    IsReadOnly="True" />

                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding PatientId}"
                                    Header="ID пациента"
                                    IsReadOnly="True" />

                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding StudyDate}"
                                    Header="Дата"
                                    IsReadOnly="True" />

                                <DataGridTextColumn
                                    Width="3*"
                                    Binding="{Binding StudyInstanceUid}"
                                    Header="ID исследования"
                                    IsReadOnly="True" />

                                <DataGridTextColumn
                                    Width="75"
                                    Binding="{Binding FileCount}"
                                    Header="Файлы"
                                    IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>

            <!--  Статус и отправка  -->
            <Grid Grid.Row="2" Margin="5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="OutputText"
                    MinHeight="42"
                    Padding="8"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                    BorderThickness="4">

                    <TextBox
                        Height="40"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        BorderThickness="0"
                        FontSize="18"
                        IsReadOnly="True"
                        Text="{Binding ServerOutputText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Border>

                <Button
                    Grid.Column="1"
                    Width="120"
                    Height="42"
                    Margin="10,0,0,0"
                    Background="{DynamicResource MahApps.Brushes.Accent}"
                    Command="{Binding SendDicomImageCommand}"
                    Content="Отправить" />
            </Grid>

            <!--  Блокировка интерфейса во время операции  -->
            <Grid
                Grid.Row="0"
                Grid.RowSpan="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">

                <Border
                    Background="White"
                    CornerRadius="1"
                    Opacity="0.7">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <mah:ProgressRing
                            Width="100"
                            Height="100"
                            Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                            IsActive="{Binding IsBusy}" />

                        <TextBlock
                            Margin="0,-60,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                            Text="{Binding CurrentProgress, StringFormat='{}{0}%'}" />
                        <TextBlock
                            Margin="0,30,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="Black"
                            Text="{Binding BusyMessage}" />
                    </StackPanel>
                </Border>
                <Button
                    Height="50"
                    Margin="5"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource MahApps.Brushes.Accent}"
                    Command="{Binding CancaelSendingImageCommand}"
                    Content="Отмена" />
            </Grid>
        </Grid>
    </Border>

</UserControl>
