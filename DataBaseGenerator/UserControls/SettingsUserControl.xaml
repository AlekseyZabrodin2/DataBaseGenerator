<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.SettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:DataBaseGenerator.UI.Wpf.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:SettingsViewModel}"
    d:DesignHeight="500"
    d:DesignWidth="800"
    mc:Ignorable="d">


    <Border
        Margin="5"
        Padding="5"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">

                <TextBlock
                    Margin="0,0,0,20"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Настройки подключения" />

                <!--  MySQL  -->
                <GroupBox
                    Margin="0,0,0,20"
                    Padding="15"
                    Header="MySQL">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            FontWeight="DemiBold"
                            Text="Сервер:" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5"
                            Text="{Binding Settings.MySqlServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            FontWeight="DemiBold"
                            Text="Порт:" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5"
                            Text="{Binding Settings.MySqlPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            FontWeight="DemiBold"
                            Text="База данных:" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="5"
                            Text="{Binding Settings.MySqlDatabase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="3"
                            VerticalAlignment="Center"
                            FontWeight="DemiBold"
                            Text="Пользователь:" />
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="5"
                            Text="{Binding Settings.MySqlUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="4"
                            VerticalAlignment="Center"
                            FontWeight="DemiBold"
                            Text="Пароль:" />
                        <PasswordBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="5"
                            PasswordChanged="PasswordBox_PasswordChanged" />
                    </Grid>
                </GroupBox>

                <!--  WebHost  -->
                <GroupBox
                    Margin="0,0,0,20"
                    Padding="15"
                    Header="WebHost">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="DemiBold"
                            Text="Адрес сервиса:" />
                        <TextBox
                            Grid.Column="1"
                            Margin="5"
                            Text="{Binding Settings.WebHostUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            FontWeight="DemiBold"
                            Text="Адрес API" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5"
                            Text="{Binding Settings.WebHostApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </GroupBox>

                <TextBlock
                    HorizontalAlignment="Right"
                    FontSize="14"
                    Margin="0,0,0,20"
                    Text="{Binding SaveStatus}"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Green" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSaveSuccessful}" Value="False">
                                    <Setter Property="Foreground" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Right"
                    Command="{Binding SaveSettingsCommand}"
                    Content="Сохранить" />

            </StackPanel>
        </ScrollViewer>
    </Border>

</UserControl>
