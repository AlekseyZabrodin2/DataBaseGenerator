<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.DicomReaderUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:DataBaseGenerator.UI.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:DataBaseGenerator.UI.Wpf.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:DicomReaderViewModel}"
    mc:Ignorable="d">



    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}" />

                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#D6EAF8" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="False">
                        <Setter Property="Background" Value="LightGray" />
                    </Trigger>

                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#EAF2F8" />
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5,0" ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Margin="0,5,0,0"
            Padding="5"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Height="35"
                    Padding="6,0"
                    Background="#F5F5F5"
                    BorderBrush="#CCC"
                    BorderThickness="1">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding DatabasePathShort}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding DatabasePath}" />
                </Border>

                <Button
                    Grid.Column="1"
                    Width="35"
                    Height="35"
                    Margin="5,0,0,0"
                    Padding="1,0,1,4"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource MahApps.Brushes.Accent}"
                    Command="{Binding BrowseDicomFilesFolderCommand}"
                    Content="📁"
                    FontSize="20"
                    ToolTip="Выбрать файл базы данных" />

                <Button
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    Command="{Binding RefreshFilesCommand}"
                    Content="Update" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Margin="0,5"
            Background="{DynamicResource MahApps.Brushes.Accent}">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox
                        Grid.Row="0"
                        MinWidth="280"
                        Padding="5"
                        FontWeight="SemiBold"
                        ItemsSource="{Binding DicomFilesCollection}"
                        SelectedItem="{Binding SelectedFile, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="10,5,5,5"
                        Padding="1,0,1,1"
                        HorizontalAlignment="Left"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding DicomFilesCollection.Count, StringFormat='Файлов: {0}'}" />
                </Grid>


                <Grid Grid.Column="1" Margin="3,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox
                        Grid.Row="0"
                        Margin="0,0,0,3"
                        Padding="4,3"
                        mah:TextBoxHelper.ClearTextButton="True"
                        mah:TextBoxHelper.Watermark="Поиск по тегам, номерам и значениям"
                        FontSize="13"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <TabControl Grid.Row="1" TabStripPlacement="Bottom">
                        <TabItem Margin="0,4,2,0">
                            <TabItem.Header>
                                <TextBlock
                                    Padding="2,0,2,4"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="All Tags" />
                            </TabItem.Header>
                            <DataGrid
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserReorderColumns="False"
                                CanUserSortColumns="False"
                                EnableColumnVirtualization="True"
                                EnableRowVirtualization="True"
                                GridLinesVisibility="All"
                                HorizontalGridLinesBrush="#FF8A8A8A"
                                IsReadOnly="True"
                                ItemsSource="{Binding FilteredDicomTags}"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.IsDeferredScrollingEnabled="True"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Group, Element">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="{Binding Indent}"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding GroupElement}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Binding="{Binding TagDescription}" Header="Tag description" />
                                    <DataGridTextColumn Binding="{Binding Value}" Header="Value" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Margin="2,4,0,0">
                            <TabItem.Header>
                                <TextBlock
                                    Padding="2,0,2,4"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="Patient Info" />
                            </TabItem.Header>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Grid Margin="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Patient Name" />
                                    </Border>
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.PatientName}" />
                                    </Border>

                                    <Border
                                        Grid.Row="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Patient ID" />
                                    </Border>
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.PatientId}" />
                                    </Border>

                                    <Border
                                        Grid.Row="2"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Patient Birth Date" />
                                    </Border>
                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.BirthDate}" />
                                    </Border>

                                    <Border
                                        Grid.Row="3"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Patient Sex" />
                                    </Border>
                                    <Border
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.Sex}" />
                                    </Border>

                                    <Border
                                        Grid.Row="4"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Patient Age" />
                                    </Border>
                                    <Border
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.Age}" />
                                    </Border>

                                    <Border
                                        Grid.Row="5"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Patient Weight" />
                                    </Border>
                                    <Border
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.Weight}" />
                                    </Border>

                                    <Border
                                        Grid.Row="6"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Patient Address" />
                                    </Border>
                                    <Border
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.Address}" />
                                    </Border>

                                    <Border
                                        Grid.Row="7"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1" />
                                    <Border
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        Padding="12"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1" />

                                    <Border
                                        Grid.Row="8"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Study Date" />
                                    </Border>
                                    <Border
                                        Grid.Row="8"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.StudyDate}" />
                                    </Border>

                                    <Border
                                        Grid.Row="9"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Study Time" />
                                    </Border>
                                    <Border
                                        Grid.Row="9"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.StudyTime}" />
                                    </Border>

                                    <Border
                                        Grid.Row="10"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Study ID" />
                                    </Border>
                                    <Border
                                        Grid.Row="10"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.StudyId}" />
                                    </Border>

                                    <Border
                                        Grid.Row="11"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Study Modality" />
                                    </Border>
                                    <Border
                                        Grid.Row="11"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.Modality}" />
                                    </Border>

                                    <Border
                                        Grid.Row="12"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Study Description" />
                                    </Border>
                                    <Border
                                        Grid.Row="12"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.StudyDescription}" />
                                    </Border>

                                    <Border
                                        Grid.Row="13"
                                        Padding="12"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1" />
                                    <Border
                                        Grid.Row="13"
                                        Grid.Column="1"
                                        Padding="12"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1" />

                                    <Border
                                        Grid.Row="14"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Series Date" />
                                    </Border>
                                    <Border
                                        Grid.Row="14"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.SeriesDate}" />
                                    </Border>

                                    <Border
                                        Grid.Row="15"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Series Time" />
                                    </Border>
                                    <Border
                                        Grid.Row="15"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.SeriesTime}" />
                                    </Border>

                                    <Border
                                        Grid.Row="16"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,1">
                                        <TextBlock Text="Series Description" />
                                    </Border>
                                    <Border
                                        Grid.Row="16"
                                        Grid.Column="1"
                                        Padding="5"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding PatientInfo.SeriesDescription}" />
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                </Grid>

            </Grid>
        </Grid>

        <!--<Grid
            Grid.Row="0"
            Grid.RowSpan="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" Opacity=".7">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <mah:ProgressRing
                        Width="100"
                        Height="100"
                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                        IsActive="{Binding IsBusy}" />
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        Foreground="Black"
                        Text="{Binding BusyMessage}" />
                </StackPanel>
            </Border>
        </Grid>-->
    </Grid>

</UserControl>