<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.PatientLiteDbTableUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:DataBaseGenerator.UI.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:DataBaseGenerator.Core.LiteDbGenerator.Enums;assembly=DataBaseGenerator.Core"
    xmlns:local="clr-namespace:DataBaseGenerator.UI.Wpf.UserControls"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="clr-namespace:DataBaseGenerator.UI.Wpf.UserControls"
    xmlns:viewmodel="clr-namespace:DataBaseGenerator.UI.Wpf.ViewModel">



    <UserControl.Resources>
        <convert:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter" />
        <x:Array x:Key="PatientSexValues" Type="{x:Type enums:PatientSex}">
            <enums:PatientSex>Male</enums:PatientSex>
            <enums:PatientSex>Female</enums:PatientSex>
            <enums:PatientSex>Other</enums:PatientSex>
        </x:Array>
    </UserControl.Resources>


    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <userControls:SelectionFileUserControl Margin="0,5" />

        <Grid
            Name="PatientTable"
            Grid.Row="1"
            Background="{DynamicResource MahApps.Brushes.Accent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="5,5,5,0" Orientation="Horizontal">
                <TextBlock
                    Margin="10,0,8,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="ID пациента" />
                <TextBox
                    Width="120"
                    VerticalContentAlignment="Center"
                    BorderBrush="Black"
                    Text="{Binding PatientIdFilter, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <DataGrid
                Name="ViewAllPatient"
                Grid.Row="1"
                Margin="5"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                IsReadOnly="{Binding IsReadOnlyMode}"
                ItemsSource="{Binding AllPatients}"
                ScrollViewer.IsDeferredScrollingEnabled="True"
                SelectedItem="{Binding SelectedPatient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Binding="{Binding Id}"
                        Header="Id DB"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Binding="{Binding PatientID}"
                        Header="ID"
                        IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Фамилия" />
                    <DataGridTextColumn Binding="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Имя" />
                    <DataGridTextColumn Binding="{Binding MiddleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Отчество" />
                    <DataGridTextColumn
                        Binding="{Binding FullName}"
                        Header="Полное имя"
                        IsReadOnly="True" />
                    <DataGridComboBoxColumn
                        Header="Пол"
                        ItemsSource="{Binding Source={StaticResource PatientSexValues}}"
                        SelectedItemBinding="{Binding Sex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Binding="{Binding BirthDate, Mode=TwoWay, StringFormat='dd.MM.yyyy'}" Header="Дата Рождения" />
                    <DataGridTextColumn Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Адрес" />
                    <DataGridTextColumn Binding="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Телефон" />
                    <DataGridTextColumn Binding="{Binding Comments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Комментарий" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid
            Grid.Row="2"
            Grid.RowSpan="2"
            Grid.Column="1"
            Grid.ColumnSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Expander
                Name="BlockCheckBoxes"
                Header="Параметры генерации"
                IsExpanded="False">
                <userControls:PatientGenerationOptionsControl DataContext="{Binding GenerationOptions}" />
            </Expander>

            <StackPanel
                Name="ButtonsBlock"
                Grid.Row="1"
                Margin="5"
                HorizontalAlignment="Stretch"
                IsEnabled="{Binding IsReadOnlyMode, Mode=TwoWay, Converter={StaticResource BoolToInverseBoolConverter}}"
                Orientation="Horizontal">

                <TextBlock
                    Name="PatCount"
                    Margin="5"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="Bold"
                    Text="Patient Count" />

                <TextBox
                    Name="PatientCount"
                    Width="100"
                    Height="50"
                    Margin="10,0,15,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource MahApps.Brushes.Button.Border}"
                    BorderBrush="Black"
                    FontWeight="Bold"
                    Text="{Binding SetPatientCount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableIntConverter}}" />

                <Button
                    Name="AddPatient"
                    Width="80"
                    Height="50"
                    Margin="0,0,5,0"
                    Command="{Binding AddPatientCommand}">
                    <TextBlock
                        Margin="5,0"
                        FontSize="10"
                        Text="ADD PATIENT"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Button>

                <Button
                    Name="SavePatient"
                    Width="80"
                    Height="50"
                    Margin="0,0,5,0"
                    Command="{Binding SavePatientsCommand}">
                    <TextBlock
                        Margin="5,0"
                        FontSize="10"
                        Text="SAVE PATIENT"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Button>

                <Button
                    Name="UpdatePatient"
                    Width="80"
                    Height="50"
                    Margin="0,0,5,0"
                    Command="{Binding RefreshDataBaseCommand}">
                    <TextBlock
                        FontSize="10"
                        Text="UPDATE PATIENT"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Button>

                <Button
                    Name="CleanCheckbox"
                    Width="80"
                    Height="50"
                    Margin="0,0,20,0"
                    Command="{Binding CleanCheckboxesCommand}">
                    <TextBlock
                        FontSize="10"
                        Text="CLEAN CHECKBOX"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Button>

                <Button
                    Name="DeleteFirstPatient"
                    Width="80"
                    Height="50"
                    Margin="0,0,5,0"
                    Command="{Binding DeleteFirstPatientCommand}">
                    <TextBlock
                        Margin="5,0"
                        FontSize="10"
                        Text="DELETE FIRST"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Button>

                <Button
                    Name="DeleteSelected"
                    Width="80"
                    Height="50"
                    Margin="0,0,5,0"
                    Command="{Binding DeleteSelectedPatientCommand}">
                    <TextBlock
                        Margin="5,0"
                        FontSize="10"
                        Text="DELETE SELECTED"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Button>

                <Button
                    Name="DeleteAllPatient"
                    Width="80"
                    Height="50"
                    Command="{Binding DeleteAllPatientCommand}">
                    <TextBlock
                        Margin="10,0"
                        FontSize="10"
                        Text="DELETE ALL"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Button>
            </StackPanel>
        </Grid>

        <userControls:FooterUserControl Grid.Row="4" Margin="0,5" />

    </Grid>
</UserControl>
