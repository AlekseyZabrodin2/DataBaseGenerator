<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.LiteDbViewerUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:DataBaseGenerator.UI.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:DataBaseGenerator.UI.Wpf.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:LiteDbViewerViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5,0" ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Margin="0,5,0,0"
            Padding="5"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Height="35"
                    Padding="6,0"
                    Background="#F5F5F5"
                    BorderBrush="#CCC"
                    BorderThickness="1">
                    <ComboBox
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        DisplayMemberPath="Title"
                        ItemsSource="{Binding Files}"
                        SelectedItem="{Binding SelectedFile}"
                        ToolTip="{Binding SelectedFile.Path}">
                        <ComboBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="ComboBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </Border>

                <Button
                    Grid.Column="1"
                    Width="35"
                    Height="35"
                    Margin="5,0,0,0"
                    Padding="1,0,1,4"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource MahApps.Brushes.Accent}"
                    Command="{Binding BrowseFileCommand}"
                    Content="📁"
                    FontSize="20"
                    ToolTip="Выбрать файл базы данных" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Режим:" />
                    <ToggleButton
                        Margin="0,0,5,0"
                        Focusable="False"
                        IsChecked="True"
                        IsHitTestVisible="False"
                        Style="{StaticResource ToggleButtonStyle}"
                        ToolTip="Просмотр только для чтения" />
                </StackPanel>

                <Button
                    Grid.Column="3"
                    Height="35"
                    Margin="5,0,0,0"
                    Command="{Binding RefreshCommand}"
                    Content="Update data"
                    ToolTip="Обновить данные из файла" />

                <CheckBox
                    Grid.Column="4"
                    Margin="8,0,4,0"
                    VerticalAlignment="Center"
                    Content="Автообновление"
                    FontWeight="SemiBold"
                    IsChecked="{Binding AutoRefresh}"
                    ToolTip="Перечитывать файл каждые 10 секунд" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Margin="0,5,0,0"
            Background="{DynamicResource MahApps.Brushes.Accent}">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox
                    Padding="5"
                    FontWeight="SemiBold"
                    ItemsSource="{Binding Collections}"
                    SelectedItem="{Binding SelectedCollection}" />

                <Grid Grid.Column="1" Margin="5,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Поиск" />
                        <TextBox
                            Width="240"
                            Height="28"
                            VerticalContentAlignment="Center"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Оставляет строки, где текст есть в любой колонке" />
                    </StackPanel>

                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        EnableColumnVirtualization="True"
                        EnableRowVirtualization="True"
                        GridLinesVisibility="All"
                        HorizontalGridLinesBrush="#FF8A8A8A"
                        IsReadOnly="True"
                        ItemsSource="{Binding Rows}"
                        ScrollViewer.IsDeferredScrollingEnabled="True"
                        VerticalGridLinesBrush="#FF8A8A8A"
                        VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.ColumnHeaderStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                <Setter Property="Padding" Value="12,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="BorderBrush" Value="#FF8A8A8A" />
                                <Setter Property="BorderThickness" Value="0,0,2,2" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                                <Setter Property="Padding" Value="5,2" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                SnapsToDevicePixels="True">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>

        <Border
            Grid.Row="2"
            Margin="0,5"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="4">
            <TextBox
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="20"
                IsReadOnly="True"
                Text="{Binding StatusText}" />
        </Border>

        <Grid
            Grid.Row="0"
            Grid.RowSpan="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" Opacity=".7">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <mah:ProgressRing
                        Width="100"
                        Height="100"
                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                        IsActive="{Binding IsBusy}" />
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        Foreground="Black"
                        Text="{Binding BusyMessage}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>