<UserControl
    x:Class="DataBaseGenerator.UI.Wpf.UserControls.LiteDbViewerUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:DataBaseGenerator.UI.Wpf.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:LiteDbViewerViewModel}"
    mc:Ignorable="d">
    <Grid Margin="5,0" ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Margin="0,5,0,0"
            Padding="5"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Height="35"
                    Padding="6,0"
                    Background="#F5F5F5"
                    BorderBrush="#CCC"
                    BorderThickness="1">
                    <ComboBox
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        DisplayMemberPath="Title"
                        ItemsSource="{Binding Files}"
                        SelectedItem="{Binding SelectedFile}"
                        ToolTip="{Binding SelectedFile.Path}">
                        <ComboBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="ComboBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </Border>

                <Button
                    Grid.Column="1"
                    Width="35"
                    Height="35"
                    Margin="5,0,0,0"
                    Padding="1,0,1,4"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource MahApps.Brushes.Accent}"
                    Command="{Binding BrowseFileCommand}"
                    Content="📁"
                    FontSize="20"
                    ToolTip="Выбрать файл базы данных" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Margin="0,5,0,0"
            Background="{DynamicResource MahApps.Brushes.Accent}">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox
                    FontWeight="SemiBold"
                    Padding="5"
                    ItemsSource="{Binding Collections}"
                    SelectedItem="{Binding SelectedCollection}" />

                <DataGrid
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    AutoGenerateColumns="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    EnableColumnVirtualization="True"
                    EnableRowVirtualization="True"
                    GridLinesVisibility="All"
                    HorizontalGridLinesBrush="#FF8A8A8A"
                    IsReadOnly="True"
                    ItemsSource="{Binding Rows}"
                    ScrollViewer.IsDeferredScrollingEnabled="True"
                    VerticalGridLinesBrush="#FF8A8A8A"
                    VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle>
                        <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderBrush" Value="#FF8A8A8A" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                            <Setter Property="Padding" Value="5,6" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border
                                            Padding="{TemplateBinding Padding}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>
            </Grid>
        </Grid>

        <Border
            Grid.Row="2"
            Margin="0,5"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="4">
            <TextBox
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="20"
                IsReadOnly="True"
                Text="{Binding StatusText}" />
        </Border>
    </Grid>
</UserControl>
